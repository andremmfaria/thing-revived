/controller/target/
/daemon/target/
*.log

# build/build-image.sh generated content - never committed:
# build/overlay/, build/build-image.sh, build/flash-image.sh and build/README.md
# ARE committed. Build outputs under build/artifact/ are never committed (only
# the .gitkeep placeholder is); everything else under build/ is a scratch
# clone or output.
/build/tmp-*/
/build/*.tmp/

# flashable images produced by build/build-image.sh; keep the directory itself
/build/artifact/*
!/build/artifact/.gitkeep

# Defensive: the baked SSH public key is written only into the scratch Yocto
# checkout by build/build-image.sh, never into this repo.
kiosk.authorized_keys
*.authorized_keys
!/build/tools/fixtures/**
__pycache__/
