[Unit]
Description=Bind the USB gadget UDC when adbd is disabled (synthetic fixture)
ConditionPathExists=!/etc/usb-debugging-enabled
Requires=superbird-usb-gadget.service
After=superbird-usb-gadget.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/thing-revived/thing-revived-usb-bind start
ExecStop=/usr/libexec/thing-revived/thing-revived-usb-bind stop

[Install]
WantedBy=multi-user.target
