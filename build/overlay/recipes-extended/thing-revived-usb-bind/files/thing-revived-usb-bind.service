[Unit]
Description=Bind the USB gadget UDC when adbd is disabled
# Mutually exclusive with android-tools-adbd.service, whose drop-in binds the UDC itself and is
# gated on the same file. With ADB=1 builds the file exists and this unit is skipped.
ConditionPathExists=!/etc/usb-debugging-enabled
Requires=superbird-usb-gadget.service
After=superbird-usb-gadget.service superbird-usb-role.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/thing-revived/thing-revived-usb-bind start
ExecStop=/usr/libexec/thing-revived/thing-revived-usb-bind stop

[Install]
WantedBy=multi-user.target
