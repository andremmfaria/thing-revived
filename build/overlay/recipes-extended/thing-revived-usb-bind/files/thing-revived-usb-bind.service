[Unit]
Description=Bind the USB gadget UDC when adbd is disabled
# Mutually exclusive with android-tools-adbd.service: starting either side stops the other
# (Conflicts=) and After= on both sides makes sure the stop finishes before the new side binds
# the UDC (docs/research/debug-toggles-spikes.md item c). The unit ships disabled: boot-time
# state is decided by thing-revived-device-apply.service from the persisted settings, not by a
# Condition here, so a manual or runtime `systemctl start thing-revived-usb-bind.service`
# always runs.
Conflicts=android-tools-adbd.service
Requires=superbird-usb-gadget.service
After=superbird-usb-gadget.service superbird-usb-role.service android-tools-adbd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/thing-revived/thing-revived-usb-bind start
ExecStop=/usr/libexec/thing-revived/thing-revived-usb-bind stop

[Install]
WantedBy=multi-user.target
