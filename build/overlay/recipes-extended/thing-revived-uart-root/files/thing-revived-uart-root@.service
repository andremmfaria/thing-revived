[Unit]
Description=Root autologin console on %I (thing-revived UART debug toggle)
Documentation=man:agetty(8)
BindsTo=dev-%i.device
After=dev-%i.device systemd-user-sessions.service
# Conflicts with the matching serial-getty instance only (template %i scoping); other tty
# instances are untouched. After= lets the stock unit's stop (which Conflicts= triggers
# automatically on this unit's start) finish before this one binds the tty.
Conflicts=serial-getty@%i.service
After=serial-getty@%i.service
IgnoreOnIsolate=yes
ConditionPathExists=/dev/%I

[Service]
# Filled in at image build time by thing_revived_console_gate (superbird-kiosk-prod-image.
# bbappend), which copies the stock serial-getty@.service's own ExecStart line from the SAME
# rootfs verbatim and inserts --autologin root, so baud rate and $TERM always match the stock
# console exactly. Done unconditionally on every build, not only when THING_REVIVED_ENABLE_UART=1,
# because this unit always ships and must be a valid, immediately startable alternative
# regardless of the boot default (the runtime toggle works on every build).
ExecStart=@@THING_REVIVED_STOCK_GETTY_ARGS@@
Type=idle
Restart=always
RestartSec=0
UtmpIdentifier=%I
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes

[Install]
WantedBy=getty.target
